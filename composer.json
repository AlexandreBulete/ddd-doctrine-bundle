{
  "name": "alexandrebulete/ddd-doctrine-bundle",
  "description": "Symfony Bundle for DDD Doctrine Bridge - Service wiring and configuration",
  "type": "symfony-bundle",
  "license": "MIT",
  "authors": [
    {
      "name": "Alexandre Bulete"
    }
  ],
  "require": {
    "php": "^8.4",
    "alexandrebulete/ddd-doctrine-bridge": "^1.4",
    "symfony/framework-bundle": "^7.4 || ^8.0",
    "symfony/config": "^7.4 || ^8.0",
    "symfony/dependency-injection": "^7.4 || ^8.0"
  },
  "autoload": {
    "psr-4": {
      "AlexandreBulete\\DddDoctrineBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AlexandreBulete\\DddDoctrineBundle\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^12.0 || ^13.0"
  },
  "scripts": {
    "phpstan": "phpstan analyse --no-progress",
    "test": "phpunit",
    "qa": [
      "@phpstan",
      "@test"
    ]
  }
}
